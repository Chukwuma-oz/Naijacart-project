# ---- AWS mode (instead of DB_* above) ----
# Set this to the ARN of a Secrets Manager secret (RDS type or a JSON secret
# with host/username/password/dbname/port). The instance/task IAM role must
# allow secretsmanager:GetSecretValue on it. Do NOT set DB_PASSWORD in AWS.
# DB_SECRET_ARN=arn:aws:secretsmanager:af-south-1:123456789012:secret:naijacart-db-XXXXXX
# CORS_ORIGIN=https://dXXXXXXXXXXXX.cloudfront.net
# REDIS_URL=redis://naijacart-cache.xxxxxx.cache.amazonaws.com:6379
